{
  "name": "obsidian-bases-enhancements",
  "version": "0.1.1",
  "private": true,
  "description": "Centered favorite tabs, compact Kanban cards, and practical improvements for Obsidian Bases.",
  "license": "MIT",
  "author": "DannieBGoode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DannieBGoode/obsidian-bases-enhancements.git"
  },
  "bugs": {
    "url": "https://github.com/DannieBGoode/obsidian-bases-enhancements/issues"
  },
  "homepage": "https://github.com/DannieBGoode/obsidian-bases-enhancements#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:native": "node scripts/native-smoke.mjs",
    "test:kanban": "node scripts/native-smoke.mjs --kanban-only",
    "install:vault": "node scripts/install.mjs",
    "test:creation": "node scripts/native-smoke.mjs --creation-only"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "esbuild": "0.25.12",
    "obsidian": "1.12.3",
    "typescript": "5.9.3"
  }
